rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function incoming() { 
      return request.resource.data; 
    }
    
    function existing() { 
      return resource.data; 
    }
    
    function isValidHymnOverride(data) {
      return data.keys().hasAll(['id', 'number', 'title', 'verses', 'category', 'isVerified', 'verifiedAt', 'updatedAt'])
        && data.keys().size() <= 12
        && (data.id is int || data.id is float)
        && (data.number is int || data.number is float)
        && data.title is string && data.title.size() <= 200
        && data.category is string && data.category.size() <= 100
        && data.verses is list && data.verses.size() > 0 && data.verses.size() <= 50 && data.verses[0] is string
        && data.isVerified is bool
        && data.verifiedAt is string && data.verifiedAt.size() <= 100
        && data.updatedAt is string && data.updatedAt.size() <= 100
        && (!data.keys().hasAny(['chorus']) || (data.chorus is string && data.chorus.size() <= 1000))
        && (!data.keys().hasAny(['author']) || (data.author is string && data.author.size() <= 200))
        && (!data.keys().hasAny(['tune']) || (data.tune is string && data.tune.size() <= 200))
        && (!data.keys().hasAny(['melody']) || (data.melody is list && data.melody.size() <= 200));
    }

    match /hymn_overrides/{hymnId} {
      allow get, list: if true;
      allow create: if isValidId(hymnId) && isValidHymnOverride(incoming());
      allow update: if isValidId(hymnId) && isValidHymnOverride(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['id', 'number', 'title', 'verses', 'category', 'isVerified', 'verifiedAt', 'updatedAt', 'chorus', 'author', 'tune', 'melody'])
      );
    }
  }
}
